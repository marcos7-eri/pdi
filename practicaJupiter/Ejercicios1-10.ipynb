   "source": [
    "\n",
    "numero = int(input(\"ingresar numero entero: \"))\n",
    "\n",
    "if numero < 0:\n",
    "    print(\"no existe fac. numero negativo\")\n",
    "else:\n",
    "    factorial = 1\n",
    "    for i in range(1, numero + 1):\n",
    "        factorial *= i\n",
    "    print(f\"El factorial de {numero} es {factorial}\")"
   ]
  }
